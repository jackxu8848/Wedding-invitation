# --- Server (copy to .env in project root; never commit real secrets) ---

# Secret you type on /admin to send emails (choose a long random string).
ADMIN_SECRET=

# Public URL of the invitation site (used in invitation emails), no trailing slash.
# Local dev: http://localhost:5173
INVITATION_BASE_URL=http://localhost:5173

# Gmail: use the same account; create an App Password in Google Account → Security.
GMAIL_USER=jackxu8848@gmail.com
GMAIL_APP_PASSWORD=

# Google Sheet: create a sheet with row 1 headers:
# Full name | email | Child/Adult | Age
# Share the sheet with the service account email (from the JSON below) as Editor.
SPREADSHEET_ID=
SHEET_NAME=Sheet1

# Path to the service account JSON key file (download from Google Cloud Console).
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json

# Optional: if the API is on another origin than the Vite app, set the full API base (no trailing slash).
# VITE_API_BASE_URL=
